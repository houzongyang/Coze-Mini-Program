# API base URLs are embedded at build time. Do not include a trailing slash.
# PROJECT_DOMAIN has priority when it is supplied by CI or the local shell.
# build-weapp.bat defaults API_ENV to development; set API_ENV=production for release builds.
#
# WeChat mini-program builds require an absolute HTTP(S) URL. The HTTPS host
# must also be added to the mini-program's request and uploadFile legal-domain lists.
API_BASE_URL_DEVELOPMENT=
API_BASE_URL_PRODUCTION=
